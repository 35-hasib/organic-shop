{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "organic-shop",
  "compatibility_date": "2026-11-11",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/sitemap.xml"]
  }
}
